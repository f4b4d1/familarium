{
  "name": "familarium",
  "version": "0.0.0",
  "private": true,
  "description": "Lokale App zur Ahnenforschung: Stammbaum ansehen, Angaben belegen, Lücken recherchieren",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "demo:build": "node demo/build-demo.ts",
    "entwuerfe": "vite --open /prototypes/",
    "privacy:audit": "node scripts/privacy-guard.mjs audit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
